# ============================================================
# TRAVA DE SEGURANCA - este repo esta na raiz do /home/jp
# Logica: ignora TUDO por padrao, e libera so o que e do projeto.
# Assim uma chave SSH/AWS nova nunca entra por descuido.
# Pra versionar uma pasta nova: adiciona um "!/nome-da-pasta/" abaixo.
# ============================================================

/*

!/.github/
!/App/
!/Terraform/
!/README.md
!/README_EN.md
!/.gitignore

# ============================================================
# 2a camada: mesmo DENTRO das pastas liberadas, isso nunca entra
# ============================================================
.ssh/
.aws/
.gnupg/
.pki/
id_rsa*
id_ed25519*
id_ecdsa*
*_history
.claude.json
.netrc
# Terraform
**/.terraform/*
**/.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraform.tfstate.lock.info

# Chaves e Credenciais
*.pem
*.key
*.ppk
*.p12
*.pfx
.env
.env.*
credentials
aws_credentials
*.credentials

# Scripts de setup
setup-backend.sh

# Logs
*.log
*.tmp
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo
*.sublime-*
.project

# Python
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
ENV/

# Node
node_modules/
package-lock.json

# Docker
docker-compose.override.yml

# Backup
*.bak
*.backup
*~
.*.swp

# Outros
.cache/
.pytest_cache/
